# --- Telegram ---
BOT_TOKEN=123456789:AAExampleTelegramBotToken
ADMIN_CHAT_ID=123456789
# Foydalanuvchi mini-app'ga kirish uchun link (start buyrug'i ichida ko'rsatiladi)
MINI_APP_URL=https://your-mini-app.vercel.app

# --- Supabase ---
SUPABASE_URL=https://xxxxxxxx.supabase.co
# Diqqat: bu SERVICE ROLE key — faqat backend serverda ishlatiladi, hech qachon frontendga qo'yilmaydi!
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# --- Server ---
PORT=8080
# Frontend qaysi origin'dan so'rov yuborishiga ruxsat (CORS)
FRONTEND_ORIGIN=https://your-mini-app.vercel.app

# --- Bot ishlash rejimi ---
# "polling" (dev uchun qulay) yoki "webhook" (production uchun tavsiya)
BOT_MODE=polling
# webhook rejimida ishlatiladigan public URL (masalan https://your-backend.onrender.com)
WEBHOOK_URL=
